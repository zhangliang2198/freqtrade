{
  "telegram": {
    "proxy_url": "http://127.0.0.1:3128",
    "connect_timeout": 20,
    "read_timeout": 20,
    "write_timeout": 20,
    "pool_timeout": 10,
    "polling_restart_seconds": 5
  },
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 11,
  "exchange_accounting": {
    "enabled": true,
    "interval_seconds": 900,
    "overlap_seconds": 120,
    "settlement_delay_seconds": 300,
    "initial_lookback_days": 89,
    "page_size": 1000,
    "max_pages_per_trade": 30,
    "batch_size": 3
  },
  "manual_position_sync": {
    "enabled": true,
    "import_positions": true,
    "auto_exit_positions": false,
    "manage_protective_stops": true,
    "cleanup_orphan_stops": true,
    "interval_seconds": 60,
    "orphan_stop_interval_seconds": 900,
    "confirmations": 2,
    "history_lookback_days": 89,
    "history_limit": 1000
  },
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "CNY",
  "dry_run": false,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "cross",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "ccxt_config": {
      "httpsProxy": "http://127.0.0.1:3128",
      "wsProxy": "http://127.0.0.1:3128"
    },
    "ccxt_async_config": {}
  },
  "strategy": "LeaderSqueezeStrategy",
  "bot_name": "freqtrade",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  },
  "logfile": "user_data/logs/leader-squeeze-live.log",
  "add_config_files": [
    "strategies/leader_squeeze/config.json",
    "config-blacklist.json",
    "config-private.json"
  ],
  "user_data_dir": "user_data",
  "strategy_path": "user_data/strategies/leader_squeeze"
}
